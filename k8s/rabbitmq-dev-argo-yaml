apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: rabbitmq-dev
  namespace: argocd
spec:
  project: default

  source:
    repoURL: https://github.com/Kebertr/m7011e-gitops.git
    targetRevision: main
    path: k8s/rabbitmq
    helm:
      valueFiles:
        - ../environments/rabbitmq/dev/values.yaml

  destination:
    server: https://kubernetes.default.svc
    namespace: rabbitmq-dev

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
